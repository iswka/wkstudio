syntax = "v1"

info(
    title: "密码管理服务"
    desc: "密码记录的增删改查"
    author: "wkstudio"
    version: "v1.0"
)

// 创建密码请求
type CreatePasswordReq {
    Title       string `json:"title" validate:"required,max=200"`
    Description string `json:"description,optional"`
    Password    string `json:"password" validate:"required"`
}

// 创建密码响应
type CreatePasswordResp {
    ID    int64  `json:"id"`
    Title string `json:"title"`
    Message string `json:"message"`
}

// 获取密码列表请求
type GetPasswordListReq {
    Page     int64 `json:"page,optional,default=1"`
    PageSize int64 `json:"page_size,optional,default=20"`
}

// 密码项
type PasswordItem {
    ID          int64  `json:"id"`
    Title       string `json:"title"`
    Description string `json:"description"`
    CreatedAt   string `json:"created_at"`
    UpdatedAt   string `json:"updated_at"`
}

// 获取密码列表响应
type GetPasswordListResp {
    List     []PasswordItem `json:"list"`
    Total    int64          `json:"total"`
    Page     int64          `json:"page"`
    PageSize int64          `json:"page_size"`
}

// 获取密码详情请求
type GetPasswordDetailReq {
    ID int64 `json:"id" validate:"required"`
}

// 获取密码详情响应
type GetPasswordDetailResp {
    ID          int64  `json:"id"`
    Title       string `json:"title"`
    Description string `json:"description"`
    Password    string `json:"password"`
    CreatedAt   string `json:"created_at"`
    UpdatedAt   string `json:"updated_at"`
}

// 更新密码请求
type UpdatePasswordReq {
    ID          int64  `json:"id" validate:"required"`
    Title       string `json:"title" validate:"required,max=200"`
    Description string `json:"description,optional"`
    Password    string `json:"password" validate:"required"`
}

// 通用响应
type CommonResp {
    Message string `json:"message"`
}

// 删除密码请求
type DeletePasswordReq {
    ID int64 `json:"id" validate:"required"`
}

// 所有接口都需要JWT认证
@server(
    jwt: Auth
    group: password
    middleware: AuthMiddleware
)
service password-service {
    @doc "创建密码记录"
    @handler createPassword
    post /api/password/create (CreatePasswordReq) returns (CreatePasswordResp)
    
    @doc "获取密码列表"
    @handler getPasswordList
    get /api/password/list (GetPasswordListReq) returns (GetPasswordListResp)
    
    @doc "获取密码详情"
    @handler getPasswordDetail
    get /api/password/detail (GetPasswordDetailReq) returns (GetPasswordDetailResp)
    
    @doc "更新密码记录"
    @handler updatePassword
    post /api/password/update (UpdatePasswordReq) returns (CommonResp)
    
    @doc "删除密码记录"
    @handler deletePassword
    post /api/password/delete (DeletePasswordReq) returns (CommonResp)
}
